# Copy these values into Streamlit Community Cloud:
# App -> Settings -> Secrets

SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "YOUR_SUPABASE_PUBLISHABLE_KEY"

# The exact public URL of the deployed Streamlit app.
# Example: https://trade-easy.streamlit.app
TRADE_EASY_PUBLIC_URL = "https://YOUR-APP.streamlit.app"

# Google/Supabase OAuth redirect back to the app.
# Usually the same public URL with a trailing slash for this app.
SUPABASE_REDIRECT_URL = "https://YOUR-APP.streamlit.app/"

# FYERS production app credentials. NEVER commit real values to GitHub.
FYERS_APP_ID = "YOUR_FYERS_APP_ID"
FYERS_SECRET_KEY = "YOUR_FYERS_SECRET_KEY"

# Must exactly match the redirect URI registered in the FYERS app.
FYERS_REDIRECT_URI = "https://YOUR-APP.streamlit.app/"
